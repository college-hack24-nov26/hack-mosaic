# deploy/.env.example — Environment Variables Template for PashuVani
# Copy this file to .env and adjust values for local development or deployment.
# NEVER commit the actual .env file to Git!

# --- Server & HTTP ---
ENV=development
PORT=8080
LOG_LEVEL=debug
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Authentication & JWT ---
JWT_SECRET=replace_with_a_secure_random_64_byte_secret_key_in_production
JWT_ACCESS_TTL_SECONDS=3600
JWT_REFRESH_TTL_SECONDS=2592000

# --- Database & PostGIS ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=pashuvani
DB_PASSWORD=pashuvani_password
DB_NAME=pashuvani_db
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10

# --- File & Media Storage ---
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./data/uploads
STORAGE_MAX_UPLOAD_SIZE_BYTES=5242880

# --- QR Code Cryptography (Ed25519) ---
# Private key for Go backend to sign offline animal health snapshots
QR_SIGNING_PRIVATE_KEY_HEX=replace_with_ed25519_private_key_hex
# Public key for verification (bundled with mobile client)
QR_SIGNING_PUBLIC_KEY_HEX=replace_with_ed25519_public_key_hex

# --- Internal Machine Learning Service (FastAPI) ---
ML_SERVICE_URL=http://localhost:8001
ML_INTERNAL_TOKEN=replace_with_shared_secret_for_internal_ml_service
ML_TIMEOUT_SECONDS=5

# --- External AI (Gemini API - P2, Optional) ---
GEMINI_API_KEY=
