# =============================================================================
# Pashuvani Dashboard — Environment Variables Example
# Copy this file to .env and fill in real values. NEVER commit .env to git.
# Vite exposes only VITE_ prefixed variables to the browser.
# =============================================================================

# Backend API Base URL
VITE_API_BASE_URL=http://localhost:8080/api/v1

# App Configuration
VITE_APP_NAME=Pashuvani Dashboard
VITE_APP_VERSION=0.1.0

# Map Configuration (OpenStreetMap — no API key needed)
# Default center: Maharashtra, India
VITE_MAP_DEFAULT_LAT=18.5204
VITE_MAP_DEFAULT_LNG=73.8567
VITE_MAP_DEFAULT_ZOOM=7
