# backend/.env.example — PashuVani Go Backend Environment Variables
# Copy to backend/.env for local execution. Never commit real secrets.

ENV=development
PORT=8080
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL 16 + PostGIS 3
DB_DRIVER=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=pashuvani
DB_PASSWORD=pashuvani_password
DB_NAME=pashuvani_db
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
AUTO_MIGRATE=true
AUTO_SEED=true
MIGRATIONS_DIR=./migrations

# Authentication & JWT
JWT_SECRET=replace_with_a_secure_random_64_byte_secret_key_in_production
JWT_ACCESS_TTL_SECONDS=3600
JWT_REFRESH_TTL_SECONDS=2592000

# Local Media Upload Storage
STORAGE_LOCAL_DIR=./data/uploads
STORAGE_MAX_UPLOAD_SIZE_BYTES=5242880

