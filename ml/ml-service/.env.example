# Environment Variables — ML Service
# Copy this file to .env and fill in actual values
# NEVER commit .env to git

# Internal service authentication key (shared with Go backend)
ML_SERVICE_SECRET_KEY=change_me_to_a_random_secret

# XGBoost model artifact paths (relative to ml-service directory)
XGBOOST_MODEL_PATH=../outbreak_predictor/artifacts/outbreak_risk_model.json
PREPROCESSOR_PATH=../outbreak_predictor/artifacts/preprocessor.pkl
FEATURE_SCHEMA_PATH=../outbreak_predictor/artifacts/feature_schema.json

# Gemini API (P1 — only needed for gemini-screen endpoint)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Service configuration
SERVICE_PORT=8001
SERVICE_HOST=0.0.0.0
LOG_LEVEL=INFO

